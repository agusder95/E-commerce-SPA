{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Order_Customer;Username=paymentgateway;Password=replace-with-your-local-password;",
    "RedisConnection": "localhost:6379"
  },
  "MercadoPago": {
    "AccessToken": "replace-with-your-mercado-pago-token",
    "WebhookSecret": "replace-with-your-webhook-signing-secret"
  },
  "JwtSettings": {
    "SecretKey": "replace-with-a-secret-of-at-least-32-characters",
    "Issuer": "PaymentGatewayAPI",
    "Audience": "PaymentGatewayReactApp",
    "ExpirationMinutes": 1440
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": "587",
    "SenderEmail": "replace-with-your-email",
    "SenderPassword": "replace-with-your-app-password"
  },
  "Cloudinary": {
    "CloudName": "replace-with-cloud-name",
    "ApiKey": "replace-with-api-key",
    "ApiSecret": "replace-with-api-secret"
  },
  "R2": {
    "AccountId": "replace-with-account-id",
    "AccessKeyId": "replace-with-access-key-id",
    "SecretAccessKey": "replace-with-secret-access-key",
    "BucketName": "replace-with-private-bucket-name"
  },
  "Store": {
    "InstagramUrl": "https://www.instagram.com/brandoni.andrea/",
    "FrontendUrl": "http://localhost:5173",
    "WebhookUrl": "replace-with-public-https-api-url/api/checkout/webhook"
  },
  "AllowedHosts": "*"
}
